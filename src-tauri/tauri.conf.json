{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rabe",
  "version": "0.2.45",
  "identifier": "de.streil.rabe",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rabe",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: cid: asset: http://asset.localhost https: http:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Icon.icon"
    ],
    "resources": [
      "resources/models/**/*"
    ],
    "macOS": {
      "files": {
        "Resources/Metadata.appintents": "gen/apple-intents/Metadata.appintents"
      },
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 432 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mailto"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFENjc5MzlDNTEwOEI5MkQKUldRdHVRaFJuSk5uclFiL1lZdmJDZ0hxdElHTThmU2hFdU1Ccnd6UjZnUUJEaFZlaFIxS2tNR0gK",
      "endpoints": [
        "https://github.com/cstreil/comail/releases/latest/download/latest.json"
      ]
    }
  }
}
